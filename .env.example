# Copia este archivo a .env y cambia los valores. NUNCA subas .env al repo.
# En docker compose (festa-infra) estos valores ya los pone el compose; esto es para correr
# el servicio suelto, fuera de un contenedor.

PORT=8085
LOG_LEVEL=info
# TRUST_PROXY=1

DATABASE_URL=postgres://payment_svc:change-me-payment@localhost:5432/payment_db
AMQP_URL=amqp://festa:change-me-rabbit@localhost:5672
JWT_ISSUER=festa-auth
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
# FESTA_CONTRACTS_DIR=../festa-infra/contracts

# Wompi (sandbox). Llaves en https://comercios.wompi.co → Desarrolladores
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=pub_test_xxx
WOMPI_PRIVATE_KEY=prv_test_xxx
WOMPI_EVENTS_SECRET=test_events_xxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxx
# A dónde vuelve el usuario después de pagar (deep link de la app)
WOMPI_REDIRECT_URL=festa://payments/result

# Costos y comisión (RN2): COMMISSION_PERCENT debe ser > WOMPI_FEE_PERCENT * (1 + IVA)
WOMPI_FEE_PERCENT=2.99
WOMPI_FEE_FIXED_CENTS=0
IVA_PERCENT=19
COMMISSION_PERCENT=8
COMMISSION_FIXED_CENTS=0
RESERVATION_HOLD_MINUTES=15

# Solo desarrollo: habilita POST /payments/orders/{id}/simulate para aprobar sin pasar por Wompi
PAYMENTS_ALLOW_SIMULATION=false
